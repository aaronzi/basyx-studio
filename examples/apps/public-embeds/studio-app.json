{
  "$schema": "../../../packages/studio-sdk/app-manifest.schema.json",
  "manifestVersion": 0,
  "id": "org.eclipse.basyx.examples.public-embeds",
  "version": "0.1.0",
  "publisher": { "name": "Eclipse BaSyx" },
  "title": { "en": "Public embeds" },
  "description": { "en": "A full-page module that embeds a public map and reads the current weather from a keyless public API." },
  "studioApi": "^0.1.3",
  "runtimes": ["hosted", "desktop"],
  "permissions": ["studio.ui.navigation"],
  "sandbox": {
    "frameOrigins": ["https://www.openstreetmap.org"],
    "connectOrigins": ["https://api.open-meteo.com"]
  },
  "contributes": {
    "modules": [
      {
        "id": "places",
        "title": { "en": "Public embeds" },
        "icon": "mdi-map-outline",
        "entry": "ui/index.html",
        "route": "places",
        "context": "global",
        "layout": "fullPage"
      }
    ]
  }
}
