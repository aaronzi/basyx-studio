{
  "name": "@basyx/model-viewer",
  "version": "0.1.2",
  "description": "3D viewer of STL, OBJ, glTF, IFC and STEP files for BaSyx Studio and its apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eclipse-basyx/basyx-studio.git",
    "directory": "packages/model-viewer"
  },
  "homepage": "https://github.com/eclipse-basyx/basyx-studio/tree/main/packages/model-viewer#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./viewer": "./src/viewer.ts",
    "./vue": "./src/vue.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./viewer": {
        "types": "./dist/viewer.d.ts",
        "default": "./dist/viewer.js"
      },
      "./vue": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      }
    }
  }
}
